<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.platform</groupId>
    <artifactId>xwiki-platform-rendering-macros</artifactId>
    <version>18.9.0-SNAPSHOT</version>
  </parent>
  <artifactId>xwiki-platform-rendering-macro-code</artifactId>
  <name>XWiki Platform - Rendering - Macro - Code</name>
  <description>Highlights code</description>
  <properties>
    <xwiki.jacoco.instructionRatio>0.84</xwiki.jacoco.instructionRatio>
    <!-- Name to display by the Extension Manager -->
    <xwiki.extension.name>Code Macro</xwiki.extension.name>
    <pygments.vfs.directory>org.xwiki.rendering.macro.code.vfs</pygments.vfs.directory>
    <pygments.version>2.21.0</pygments.version>
    <pygments.wheel>pygments-${pygments.version}-py3-none-any.whl</pygments.wheel>
  </properties>
  <dependencies>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xwiki.rendering</groupId>
      <artifactId>xwiki-rendering-macro-box</artifactId>
      <version>${rendering.version}</version>
    </dependency>
    <dependency>
      <groupId>org.graalvm.python</groupId>
      <artifactId>python-embedding</artifactId>
      <version>25.3.4.1</version>
    </dependency>
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-security-authorization-api</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <!-- Pygments is imported directly from its wheel (a zip), which the GraalPy virtual filesystem exposes on the
             Python path. The name is fixed so that the static virtual filesystem index doesn't depend on the version.
             -->
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>1.13.0</version>
        <executions>
          <execution>
            <id>download-pygments</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <url>https://files.pythonhosted.org/packages/py3/p/pygments/${pygments.wheel}</url>
              <sha256>2363c69b61c4a97c838da3b130dcd6468f4848992b21a82f2a63ec34377137d9</sha256>
              <outputDirectory>${project.build.outputDirectory}/${pygments.vfs.directory}/src</outputDirectory>
              <outputFileName>pygments.whl</outputFileName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
